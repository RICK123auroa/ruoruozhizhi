            // Webç»„ä»¶ï¼šåŠ è½½Vueé¡µé¢
            Web({ src: this.param.path, controller: this.webController })
              .zoomAccess(false) // ç¦ç”¨ç¼©æ”¾
              .width(Const.WEB_CONSTANT_WIDTH) // è®¾ç½®å®½åº¦
              .aspectRatio(1) // å®½é«˜æ¯”1:1
              .margin({
                left: 0, // å·¦è¾¹è·ä¸º0
                right: Const.WEB_CONSTANT_MARGIN_RIGHT, // å³è¾¹è·
                top: Const.WEB_CONSTANT_MARGIN_TOP // ä¸Šè¾¹è·
              })
              .backgroundColor(Color.Transparent) // èƒŒæ™¯è‰²è®¾ç½®ä¸ºé€æ˜
                // JavaScriptä»£ç†ï¼Œå…è®¸Webé¡µé¢è°ƒç”¨åŸç”Ÿæ–¹æ³•
              .javaScriptProxy({
                object: this.linkObj, // ä»£ç†å¯¹è±¡
                name: 'linkObj', // åœ¨Webé¡µé¢ä¸­çš„åç§°
                methodList: ['messageFromHtml'], // å…è®¸è°ƒç”¨çš„æ–¹æ³•åˆ—è¡¨
                controller: this.webController // æ§åˆ¶å™¨
              })

            // æç¤ºä¿¡æ¯åˆ—
            Column() {
              // æç¤ºæ ‡é¢˜
              Text($r('app.string.tip_vue'))
                .fontSize(Const.WEB_CONSTANT_TEXT_VALUE_FONT_SIZE)
                .textAlign(TextAlign.Center)
                .fontColor($r('app.color.text_value_font_color'))
                .height(Const.WEB_CONSTANT_TEXT_VALUE_HEIGHT)
                .fontWeight(Const.WEB_CONSTANT_TEXT_VALUE_FONT_WEIGHT)
                .margin({ top: Const.WEB_CONSTANT_TEXT_VALUE_MARGIN_TOP })

              // è·¯å¾„æç¤ºæ–‡æœ¬
              Text(this.param.tips)
                .fontSize(Const.WEB_CONSTANT_TIP_TEXT_VALUE_FONT_SIZE)
                .textAlign(TextAlign.Center)
                .fontColor($r('app.color.text_value_font_color'))
                .width(Const.WEB_CONSTANT_TIP_TEXT_VALUE_WIDTH)
                .height(Const.WEB_CONSTANT_TIP_TEXT_VALUE_HEIGHT)
                .opacity(Const.WEB_CONSTANT_TIP_TEXT_VALUE_OPACITY)
                .margin({ top: Const.WEB_CONSTANT_TIP_TEXT_VALUE_MARGIN_TOP })
            }

            // æ“ä½œæŒ‰é’®
            Button($r('app.string.btnValue'))
              .fontSize(Const.WEB_CONSTANT_BUTTON_FONT_SIZE)
              .fontColor($r('app.color.start_window_background'))
              .margin({ top: Const.WEB_CONSTANT_BUTTON_MARGIN_TOP })
              .width(Const.WEB_CONSTANT_BUTTON_WIDTH)
              .height(Const.WEB_CONSTANT_BUTTON_HEIGHT)
              .backgroundColor($r('app.color.blue'))
              .borderRadius(Const.WEB_CONSTANT_BUTTON_BORDER_RADIUS)
              .onClick(() => {
                // ç‚¹å‡»æŒ‰é’®æ—¶ï¼Œæ‰§è¡ŒVueé¡µé¢ä¸­çš„JavaScriptå‡½æ•°
                this.webController.runJavaScript('outWeb()');
              })
          }
          .width(Const.WEB_CONSTANT_FULL_WIDTH) // è®¾ç½®åˆ—å®½åº¦
          .height(Const.WEB_CONSTANT_FULL_HEIGHT) // è®¾ç½®åˆ—é«˜åº¦
        }
        .margin({ top: Const.WEB_CONSTANT_MARGIN_TOP }) // è®¾ç½®è¡Œä¸Šè¾¹è·
      }
      .backgroundColor($r('app.color.navy_blue')) // è®¾ç½®å †å å®¹å™¨èƒŒæ™¯é¢œè‰²
    }
    // å¯¼èˆªç›®æ ‡å°±ç»ªæ—¶çš„å›è°ƒ
    .onReady((context: NavDestinationContext) => {
      // è·å–è·¯å¾„æ ˆ
      this.pathStack = context.pathStack;
      // è·å–ä¼ é€’çš„å‚æ•°
      this.param = context.pathInfo.param as NavigatorBean;
    })
    .width(Const.WEB_CONSTANT_FULL_WIDTH) // è®¾ç½®å¯¼èˆªç›®æ ‡å®½åº¦
    .height(Const.WEB_CONSTANT_FULL_HEIGHT) // è®¾ç½®å¯¼èˆªç›®æ ‡é«˜åº¦
    .hideTitleBar(true) // éšè—æ ‡é¢˜æ 
    .hideToolBar(true) // éšè—å·¥å…·æ 
  }
